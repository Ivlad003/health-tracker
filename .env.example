# Health Tracker Bot - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# TELEGRAM
# =============================================================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# =============================================================================
# FATSECRET API
# =============================================================================
# Register at: https://platform.fatsecret.com/register
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# =============================================================================
# WHOOP API
# =============================================================================
# Register at: https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://your-domain.com/whoop/callback

# =============================================================================
# APPLE HEALTH
# =============================================================================
# iOS Shortcut posts Apple Health data to the backend webhook.
# The per-user token is generated by /connect_apple_health.
APPLE_HEALTH_SYNC_HOURS=6
# =============================================================================
# OPENAI
# =============================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/healthlog

# =============================================================================
# FATSECRET OAUTH 1.0 (for user food diary access)
# =============================================================================
# Shared Secret (different from Client Secret!) — from FatSecret API key page
FATSECRET_SHARED_SECRET=

# =============================================================================
# APP SETTINGS
# =============================================================================
APP_BASE_URL=https://your-domain.com
LOG_LEVEL=INFO
# Fallback timezone for users without a valid users.timezone (see /timezone)
DEFAULT_TIMEZONE=Europe/Kyiv
# Timeout (seconds) for every outbound HTTP call (WHOOP, FatSecret, ipify)
HTTP_TIMEOUT_SECONDS=15

# =============================================================================
# SECURITY
# =============================================================================
# HMAC key for signed OAuth `state` (WHOOP/FatSecret connect links).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, a key is derived from the WHOOP/FatSecret client secrets.
OAUTH_STATE_SECRET=
# Bearer token for operator endpoints (/debug/*, /ip-check, /fatsecret/diary,
# /food/search). Empty = these endpoints return 404.
# Use: curl -H "Authorization: Bearer $ADMIN_API_TOKEN" .../debug/stats?telegram_user_id=...
ADMIN_API_TOKEN=

# =============================================================================
# FOOD LOGGING (history, barcode, label photos) — docs/en/food-logging.md
# =============================================================================
# Default feature switches (admins can turn them off/on at runtime only where
# the capability exists).
FOOD_HISTORY_ENABLED=true
FOOD_BARCODE_ENABLED=true
FOOD_VISION_ENABLED=true
FOOD_PLATE_PHOTOS_ENABLED=false
# FatSecret Premier barcode add-on (OAuth2 scope `barcode`). Only set true when
# the FatSecret account is entitled — a flag cannot grant the entitlement.
FATSECRET_BARCODE_ENABLED=false
# Days of FatSecret diary history imported into "My Products" on connect (1–365)
FATSECRET_HISTORY_IMPORT_DAYS=30
# FatSecret storable-data rule: non-ID data cached at most 24 h (1–24)
FATSECRET_CACHE_HOURS=24
# Vision model for label/packaging/plate photos
OPENAI_VISION_MODEL=gpt-4o
VISION_MAX_CONCURRENCY=2
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PIXELS=40000000
DRAFT_TTL_HOURS=24
# Open Food Facts: pinned API version, identify yourself, shared limiter
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_API_VERSION=3.4
OFF_USER_AGENT=HealthTrackerBot/1.0 (contact: you@example.com)
OFF_READS_PER_MINUTE=15

# =============================================================================
# TELEGRAM WEB APP (backend API; frontend bundle served from web/dist if present)
# =============================================================================
# HTTPS URL of the Mini App; defaults to ${APP_BASE_URL}/app/
WEBAPP_URL=
WEBAPP_SESSION_TTL_SECONDS=3600
# Maximum age of Telegram initData at login (seconds)
WEBAPP_AUTH_MAX_AGE_SECONDS=300
# Comma-separated Telegram user ids bootstrapped once as owner/admin
# (revocation in user_roles is respected afterwards)
WEBAPP_ADMIN_TELEGRAM_IDS=

# =============================================================================
# NEW RELIC (optional)
# =============================================================================
NEW_RELIC_LICENSE_KEY=
